{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Narrow local-only capability for the TestPapers Desktop main window.",
  "local": true,
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-engine-context",
    "allow-retry-engine-start",
    "allow-get-shell-context",
    "allow-frontend-ready",
    "allow-set-theme-preference",
    "allow-set-close-behavior",
    "allow-resolve-close-request",
    "allow-preview-question-import-dialog",
    "allow-preview-paper-export-dialog",
    "allow-get-job",
    "allow-cancel-job",
    "allow-search-questions",
    "allow-get-question",
    "allow-create-question",
    "allow-update-question",
    "allow-delete-question",
    "allow-restore-question",
    "allow-list-question-revisions",
    "allow-revert-question",
    "allow-add-question-image",
    "allow-select-question-import",
    "allow-commit-question-import",
    "allow-discard-question-import",
    "allow-generate-paper",
    "allow-export-paper",
    "allow-get-backup-schedule",
    "allow-select-backup-destination",
    "allow-prepare-backup-encryption",
    "allow-configure-backup-schedule",
    "allow-create-workspace-backup",
    "allow-select-workspace-restore",
    "allow-commit-workspace-restore",
    "allow-discard-workspace-restore",
    "allow-select-data-directory",
    "allow-migrate-workspace-data-directory"
  ]
}
