# Copy to .env before supplying a local Desktop configuration. Values here are safe examples only.
TESTPAPERS_ENV=local
TESTPAPERS_DATA_DIR=.testpapers-data
TESTPAPERS_SQLITE_PATH=.testpapers-data/testpapers.sqlite3
TESTPAPERS_EXPORT_DIR=.testpapers-data/exports
TESTPAPERS_CLOUD_API_MODE=offline
TESTPAPERS_CLOUD_LOCAL_API_BASE=http://127.0.0.1:8000
TESTPAPERS_STAGING_API_BASE=https://staging-api.example.invalid
TESTPAPERS_PRODUCTION_API_BASE=https://api.example.invalid
